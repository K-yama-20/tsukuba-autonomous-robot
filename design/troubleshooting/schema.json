{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design/troubleshooting/schema.json",
  "title": "Gouda troubleshooting ledger",
  "description": "トラブルシューティング台帳（design/troubleshooting/ledger.yaml）の形式。参照先の存在は design/rules/test_troubleshooting_ledger.py が model.yaml と照合する。",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "sensitivity", "decision_refs", "related_refs", "symptom", "mechanism", "how_to_confirm", "countermeasures", "source", "recorded_on", "occurrences"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^TRB-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["監視中", "発生", "解消"]},
          "sensitivity": {"type": "array", "items": {"enum": ["safety", "operation", "intent"]}, "uniqueItems": true},
          "decision_refs": {"type": "array", "items": {"type": "string", "pattern": "^DEC-[0-9]+$"}, "uniqueItems": true},
          "related_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "symptom": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "how_to_confirm": {"type": "string", "minLength": 1},
          "countermeasures": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "recorded_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "record", "description", "evidence"],
              "additionalProperties": false,
              "properties": {
                "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                "record": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
