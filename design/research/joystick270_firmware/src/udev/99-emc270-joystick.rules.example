# Replace REQUIRED values using `udevadm info --attribute-walk --name=/dev/ttyUSB0`.
# Do not install this example unchanged.
SUBSYSTEM=="tty", ATTRS{idVendor}=="REQUIRED_VID", ATTRS{idProduct}=="REQUIRED_PID", ATTRS{serial}=="REQUIRED_SERIAL", SYMLINK+="emc270-joystick", GROUP="dialout", MODE="0660"
