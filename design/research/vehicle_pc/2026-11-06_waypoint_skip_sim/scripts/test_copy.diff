+class Assist:
+    """TEST COPY: the spot help of DEC-422 (proposal). Per axis: wanted but not moving for wait_s -> raise the stick until it moves."""
+    WAIT, RATE, LIMIT = 0.5, 0.25, 0.6
+    w_on = True
+    def __init__(self, mode): self.mode, self.st = mode, {'v': [0.0, 0.0], 'w': [0.0, 0.0]}; self.fires = 0
+    def axis(self, k, dt, cmd, act, scale, eps, moved):
+        st = self.st[k]   # [time not moving, stick]
+        if abs(cmd) < eps:
+            st[0], st[1] = 0.0, 0.0; return cmd
+        if abs(act) > moved:
+            st[0] = 0.0
+            if self.mode == 'release': st[1] = 0.0
+            return math.copysign(max(abs(cmd), st[1] * scale), cmd)
+        st[0] += dt
+        if st[0] < self.WAIT: return cmd
+        if st[1] == 0.0: st[1] = abs(cmd) / scale; self.fires += 1
+        st[1] = min(self.LIMIT, st[1] + self.RATE * dt)
+        return math.copysign(max(abs(cmd), st[1] * scale), cmd)
+    def apply(self, dt, v, w, p):
+        return self.axis('v', dt, v, p.v, p.max_v, 0.01, 0.03), (self.axis('w', dt, w, p.w, p.max_w, 0.02, 0.05) if self.w_on else w)
