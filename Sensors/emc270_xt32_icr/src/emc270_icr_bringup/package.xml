  <description>Launch, configuration, recording, and reporting for EMC-270 ICR estimation.</description>
  <maintainer email="maintainer@example.invalid">EMC-270 ICR maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>adi_imu_tr_driver_ros2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>emc270_icr_estimator</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>hesai_ros_driver</exec_depend>
  <exec_depend>kiss_icp</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
