<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>gouda_large_cloud_shm</transport_id><type>SHM</type>
      <!-- XT32 clouds contain 64000 * 26 bytes, exceeding the default 512 KiB. -->
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>gouda_loopback</transport_id><type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="gouda_observation" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>gouda_large_cloud_shm</transport_id>
        <transport_id>gouda_loopback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
