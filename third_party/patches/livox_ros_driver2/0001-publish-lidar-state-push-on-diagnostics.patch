--- /dev/null
+++ b/src/call_back/lidar_status_publisher.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MIT
+// Same license as the rest of livox_ros_driver2 (LICENSE.txt).
+//
+// Publishes the state information the LiDARs push (Livox-SDK2: SetLivoxLidarInfoCallback) on /diagnostics as
+// diagnostic_msgs/DiagnosticArray: one array with one status for each push. ROS 2 only.
+
+#ifndef LIVOX_ROS_DRIVER2_LIDAR_STATUS_PUBLISHER_H_
+#define LIVOX_ROS_DRIVER2_LIDAR_STATUS_PUBLISHER_H_
+
+#include <cstdint>
+
+#include <rclcpp/rclcpp.hpp>
+
+namespace livox_ros {
+
+class LidarStatusPublisher final {
+ public:
+  // Creates the publisher on the node and registers the SDK callback. Call after LivoxLidarSdkInit().
+  static void Start(rclcpp::Node& node);
+  // Drops the publisher: pushes that arrive later are ignored. Returns after a running callback has finished, so call it
+  // before the node goes away.
+  static void Stop();
+
+ private:
+  static void OnLidarInfo(const uint32_t handle, const uint8_t dev_type, const char* info, void* client_data);
+};
+
+}  // namespace livox_ros
+
+#endif  // LIVOX_ROS_DRIVER2_LIDAR_STATUS_PUBLISHER_H_
