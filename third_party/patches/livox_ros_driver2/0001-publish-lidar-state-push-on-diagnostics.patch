diff --git a/src/call_back/lidar_status_info.h b/src/call_back/lidar_status_info.h
new file mode 100644
index 0000000000000000000000000000000000000000..369c21658f0f221bb1a8039f7b6849b82797c172
--- /dev/null
+++ b/src/call_back/lidar_status_info.h
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: MIT
+// Same license as the rest of livox_ros_driver2 (LICENSE.txt).
+//
+// Summary of the state information a Livox LiDAR pushes (command 0x0102, LiDAR Information Push), as Livox-SDK2 passes
+// it to the callback of SetLivoxLidarInfoCallback: a JSON object written by LivoxLidarStateInfoToJson
+// (sdk_core/command_handler/parse_lidar_state_info.cpp). No ROS here, so that it can be tested on its own.
+
+#ifndef LIVOX_ROS_DRIVER2_LIDAR_STATUS_INFO_H_
+#define LIVOX_ROS_DRIVER2_LIDAR_STATUS_INFO_H_
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "rapidjson/document.h"
+
+namespace livox_ros {
+namespace lidar_status {
+
+// The same numbers as diagnostic_msgs/DiagnosticStatus (OK, WARN, ERROR, STALE).
+enum class Level : uint8_t { kOk = 0, kWarn = 1, kError = 2, kStale = 3 };
+
+// The keys copied from a push, in this order and under the names the SDK gives them. Everything else (sn, mac,
+// product_info, the *_ipcfg address blocks, ...) is left out on purpose: it identifies the unit or the network.
+static const char* const kAllowedKeys[] = {
+    "cur_work_state", "core_temp", "powerup_cnt", "last_sync_time", "time_offset", "time_sync_type", "status_code",
+    "lidar_diag_status", "lidar_flash_status", "FW_TYPE", "hms_code", "version_app", "version_loader",
+    "version_hardware"};
+
+struct Summary {
+  Level level = Level::kStale;                               // kStale: the push has no usable lidar_diag_status
+  std::vector<std::pair<std::string, std::string>> values;  // key, value as text
+};
+
+// lidar_diag_status (key 0x800E, uint16): four 4-bit module levels (bits 0-3 system, 4-7 scan, 8-11 ranging,
+// 12-15 communication); 0 normal, 1 warning, 2 error, 3 safety_err. The worst module decides. A module level above 3 is
+// not defined by the protocol and is taken as an error.
+inline Level LevelFromDiagStatus(uint16_t diag_status) {
+  unsigned worst = 0;
+  for (unsigned shift = 0; shift < 16; shift += 4) {
+    const unsigned module = (static_cast<unsigned>(diag_status) >> shift) & 0xFu;
+    if (module > worst) {
+      worst = module;
+    }
+  }
+  if (worst == 0) {
+    return Level::kOk;
+  }
+  if (worst == 1) {
+    return Level::kWarn;
+  }
+  return Level::kError;
+}
+
+// An integer in decimal. False for anything else (fractions included).
+inline bool IntegerText(const rapidjson::Value& value, std::string& text) {
+  if (value.IsUint64()) {
+    text = std::to_string(value.GetUint64());
+    return true;
+  }
+  if (value.IsInt64()) {
+    text = std::to_string(value.GetInt64());
+    return true;
+  }
+  return false;
+}
+
+// The text of one value: a JSON string as it is, an integer in decimal ("4512"), an array of integers as compact JSON
+// ("[0,0,0,0,0,0,0,0]"). Returns false for anything else (fractions, objects, arrays holding other things, true, null),
+// which is left out. The SDK writes the allowed keys only as integers, integer arrays and one string (status_code).
+inline bool ValueText(const rapidjson::Value& value, std::string& text) {
+  if (value.IsString()) {
+    text.assign(value.GetString(), value.GetStringLength());
+    return true;
+  }
+  if (value.IsArray()) {
+    std::string joined = "[";
+    for (rapidjson::Value::ConstValueIterator it = value.Begin(); it != value.End(); ++it) {
+      std::string item;
+      if (!IntegerText(*it, item)) {
+        return false;
+      }
+      if (it != value.Begin()) {
+        joined += ',';
+      }
+      joined += item;
+    }
+    joined += ']';
+    text = joined;
+    return true;
+  }
+  return IntegerText(value, text);
+}
+
+// The allowed values of a push and its level. A push that is not a JSON object gives no values and kStale.
+inline Summary Summarize(const char* info) {
+  Summary summary;
+  if (info == nullptr) {
+    return summary;
+  }
+  rapidjson::Document document;
+  document.Parse(info);
+  if (document.HasParseError() || !document.IsObject()) {
+    return summary;
+  }
+  const rapidjson::Value& root = document;
+  for (const char* key : kAllowedKeys) {
+    const rapidjson::Value::ConstMemberIterator member = root.FindMember(key);
+    std::string text;
+    if (member != root.MemberEnd() && ValueText(member->value, text)) {
+      summary.values.emplace_back(key, text);
+    }
+  }
+  const rapidjson::Value::ConstMemberIterator diag = root.FindMember("lidar_diag_status");
+  if (diag != root.MemberEnd() && diag->value.IsUint() && diag->value.GetUint() <= 0xFFFFu) {
+    summary.level = LevelFromDiagStatus(static_cast<uint16_t>(diag->value.GetUint()));
+  }
+  return summary;
+}
+
+}  // namespace lidar_status
+}  // namespace livox_ros
+
+#endif  // LIVOX_ROS_DRIVER2_LIDAR_STATUS_INFO_H_
diff --git a/src/call_back/lidar_status_publisher.cpp b/src/call_back/lidar_status_publisher.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bc07c8a77471f8c365722082dfa07668c0f95c90
--- /dev/null
+++ b/src/call_back/lidar_status_publisher.cpp
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: MIT
+// Same license as the rest of livox_ros_driver2 (LICENSE.txt).
+
+#include "lidar_status_publisher.h"
+
+#include <exception>
+#include <mutex>
+
+#include <diagnostic_msgs/msg/diagnostic_array.hpp>
+
+#include "livox_lidar_api.h"
+#include "lidar_status_info.h"
+
+namespace livox_ros {
+
+namespace {
+
+using diagnostic_msgs::msg::DiagnosticArray;
+using diagnostic_msgs::msg::DiagnosticStatus;
+using diagnostic_msgs::msg::KeyValue;
+
+// The SDK calls OnLidarInfo on its own thread (the one that handles the LiDAR's commands, while it holds an SDK lock),
+// for as long as the SDK runs, and has no way to wait for a call in progress. So what the call needs is kept here,
+// under one mutex, and never freed: Stop() clears it under the mutex, and a call after that does nothing.
+// rcl_publish() may be called from any thread as long as the publisher is not finalized at the same time
+// (rcl/publisher.h); the mutex keeps Stop() and the node's destruction from overlapping a publish.
+struct State {
+  std::mutex mutex;
+  rclcpp::Publisher<DiagnosticArray>::SharedPtr publisher;
+  rclcpp::Clock::SharedPtr clock;
+  rclcpp::Logger logger = rclcpp::get_logger("livox_lidar_status");
+};
+
+State& GetState() {
+  static State* state = new State();  // never deleted: the SDK's threads may outlive static destruction
+  return *state;
+}
+
+uint8_t ToDiagnosticLevel(lidar_status::Level level) {
+  switch (level) {
+    case lidar_status::Level::kOk:
+      return DiagnosticStatus::OK;
+    case lidar_status::Level::kWarn:
+      return DiagnosticStatus::WARN;
+    case lidar_status::Level::kError:
+      return DiagnosticStatus::ERROR;
+    case lidar_status::Level::kStale:
+      break;
+  }
+  return DiagnosticStatus::STALE;
+}
+
+}  // namespace
+
+void LidarStatusPublisher::Start(rclcpp::Node& node) {
+  State& state = GetState();
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    // An absolute name (the node's namespace does not move it) and rclcpp's default QoS: reliable, volatile, keep last 10
+    state.publisher = node.create_publisher<DiagnosticArray>("/diagnostics", 10);
+    state.clock = node.get_clock();
+    state.logger = node.get_logger();
+  }
+  SetLivoxLidarInfoCallback(OnLidarInfo, nullptr);
+}
+
+void LidarStatusPublisher::Stop() {
+  State& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  state.publisher.reset();
+  state.clock.reset();
+}
+
+void LidarStatusPublisher::OnLidarInfo(const uint32_t handle, const uint8_t dev_type, const char* info,
+                                       void* client_data) {
+  State& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (!state.publisher || !state.clock) {
+    return;
+  }
+  try {
+    const lidar_status::Summary summary = lidar_status::Summarize(info);
+    DiagnosticArray array;
+    array.header.stamp = state.clock->now();  // when the push was received
+    DiagnosticStatus status;
+    status.level = ToDiagnosticLevel(summary.level);
+    status.name = "mid360";
+    status.message = "info push";
+    status.hardware_id = "";  // no serial number and no address
+    for (const auto& pair : summary.values) {
+      KeyValue value;
+      value.key = pair.first;
+      value.value = pair.second;
+      status.values.push_back(value);
+    }
+    array.status.push_back(status);
+    state.publisher->publish(array);
+  } catch (const std::exception& e) {
+    // An exception must not reach the SDK's thread (std::terminate). This push is lost; the next one is tried again.
+    RCLCPP_WARN(state.logger, "LiDAR state push not published: %s", e.what());
+  } catch (...) {
+    RCLCPP_WARN(state.logger, "LiDAR state push not published: unknown exception");
+  }
+}
+
+}  // namespace livox_ros
