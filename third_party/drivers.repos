# Sensor drivers of the current implementation (vcstool format). The single place of the pinned commits:
# read by setup.sh (and update.sh through it) and by gouda_core/tools/install_sensor_drivers.sh.
#   ND-14 hesai_ros_driver        XT-32 (DEC-080). Submodule HesaiLidar_SDK_2.0 at 9d5dc4f comes with this commit.
#   ND-15 adi_imu_tr_driver_ros2  ADIS16607-2 (DEC-080). Submodule lib comes with this commit.
#   Livox-SDK2, livox_ros_driver2  MID-360 (DEC-442, DEC-443; ND-20 in the proposal design/proposals/mid360_architecture_2026-11-06.md).
#     Official repositories, master of 2026-09-21: SDK c0796f0 includes the Ubuntu 24.04 build fix (68ae1e1; the tag v1.3.1
#     does not), driver 2144554 supports Jazzy (1.2.6) and the SDK of the same day. setup.sh builds them in a separate
#     workspace <workspace>_livox, apart from the Gouda workspace and loaded on top of it (the SDK is installed to
#     /usr/local, where the driver looks for it). The driver is built with colcon and the CMake arguments of its build.sh
#     jazzy, from a copy of the pinned commit with package_ROS2.xml as package.xml, not with build.sh (DEC-475).
#     setup.sh applies the patches in third_party/patches/livox_ros_driver2 to that copy only (DEC-494: the MID-360's
#     state push on /diagnostics); after changing this pin, check them with third_party/patches/livox_ros_driver2/test/run_tests.sh.
# The checkouts are used unmodified (DEC-075). Hesai and ADI verified on the development VM (design/research/upstream_sensors/README.md).
# third_party/external.repos is the list of the legacy implementation (Mission Control) and is not used by setup.sh.
repositories:
  HesaiLidar_ROS_2.0:
    type: git
    url: https://github.com/HesaiTechnology/HesaiLidar_ROS_2.0.git
    version: e7e112f0809f0eed5e3c81c55a1a0376474db234
  ADI_IMU_TR_Driver_ROS2:
    type: git
    url: https://github.com/technoroad/ADI_IMU_TR_Driver_ROS2.git
    version: 742b7babec7e7a20937d4e8be0df77a771a1294a
  Livox-SDK2:
    type: git
    url: https://github.com/Livox-SDK/Livox-SDK2.git
    version: c0796f04c143143899c87a773d9f6b7136453c0b
  livox_ros_driver2:
    type: git
    url: https://github.com/Livox-SDK/livox_ros_driver2.git
    version: 21445540f0d100dc86a7e6df312dd70bbdb4afdf
