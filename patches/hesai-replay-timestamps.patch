 inline void SourceDriver::ReceivePacket(const hesai_ros_driver::msg::UdpFrame::SharedPtr msg)
 {
   for (size_t i = 0; i < msg->packets.size(); i++) {
+    const auto& packet = msg->packets[i];
+    if (packet.size == 0 || packet.size > sizeof(UdpPacket().buffer) || packet.size > packet.data.size()) {
+      RCLCPP_WARN(node_ptr_->get_logger(), "Reject malformed replay packet length");
+      continue;
+    }
