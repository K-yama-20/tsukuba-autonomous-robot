+      RCLCPP_WARN(node_ptr_->get_logger(), "Reject replay packet without valid time");
+      continue;
+    }
+    const uint64_t receive_us = uint64_t(stamp.sec) * 1000000ULL + stamp.nanosec / 1000ULL;
