<?xml version="1.0" encoding="UTF-8" ?>
<!-- TEST STACK ONLY (stack.sh, DEC-116). Not used by gouda.sh: the robot's DDS settings are unchanged.
     Larger shared-memory segment so ~2 MB point clouds stay on SHM inside the VM (G-DDS; same profile as the
     localization evaluation, design/research/vehicle_pc/2026-10-17_localization_eval/tools/fastdds_eval.xml). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_local</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="test_stack_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp_local</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
